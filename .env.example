# Kopieer dit bestand naar .env en vul je eigen keys in.
# Tools zonder key geven een nette melding, de rest werkt gewoon.

# NS Reisinformatie API (apiportal.ns.nl)
NS_API_KEY=

# EP-online energielabels (apikey.ep-online.nl, KvK-nummer mag leeg). De key komt niet per mail, bewaar hem meteen.
EP_ONLINE_API_KEY=

# KNMI Developer Portal (developer.dataplatform.knmi.nl): na Login in de API Catalogue bij Open Data API en
# bij WMS API op "Request an API key". Eén account, en elke key staat maar één keer op het scherm.
KNMI_OPEN_DATA_API_KEY=
KNMI_WMS_API_KEY=

# Vraag het Joost, de chat op de website (platform.claude.com, onder API keys). Zonder key staat de chat uit.
ANTHROPIC_API_KEY=
# Hoeveel de chat per dag mag kosten, in dollars, en hoeveel vragen iemand per dag mag stellen
# VRAAG_DAGBUDGET_USD=0.50
# VRAAG_PER_DAG=30

# Schiphol Public Flight API (developer.schiphol.nl), alleen voor vluchten in de chat, niet via MCP
SCHIPHOL_CLIENT_ID=
SCHIPHOL_CLIENT_SECRET=
# Hoeveel vluchten iemand per dag mag opzoeken, en hoeveel de hele site samen
# VLUCHT_PER_DAG=10
# VLUCHT_SITE_PER_DAG=300

# Voor hosting
# HOST=0.0.0.0
# PORT=8000
